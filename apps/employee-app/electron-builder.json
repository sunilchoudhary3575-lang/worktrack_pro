{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.worktrackpro.employee",
  "productName": "WorkTrack Pro Employee",
  "electronVersion": "28.2.0",
  "artifactName": "WorkTrackPro-Employee-Setup.exe",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WorkTrack Pro Employee",
    "uninstallDisplayName": "WorkTrack Pro Employee",
    "deleteAppDataOnUninstall": false
  },
  "extraMetadata": {
    "main": "electron/main.js"
  }
}
