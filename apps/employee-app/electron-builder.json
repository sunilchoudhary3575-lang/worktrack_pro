{
  "appId": "com.worktrackpro.employee",
  "productName": "WorkTrackPro",
  "artifactName": "WorkTrackPro-Employee-Setup.exe",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WorkTrackPro"
  },
  "extraMetadata": {
    "main": "dist-electron/main.js"
  }
}
