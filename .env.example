# ============================================================
# WorkTrack Pro — Firebase Client Configuration Example
# Copy this file to .env in the project root or inside apps/
# Replace placeholder values with configuration from Firebase Console
# NEVER commit real API keys or service account credentials!
# ============================================================

# Web App Configuration from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForWorkTrackPro
VITE_FIREBASE_AUTH_DOMAIN=worktrack-pro-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=worktrack-pro-prod
VITE_FIREBASE_STORAGE_BUCKET=worktrack-pro-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Firebase Emulator Suite (for local automated testing / emulators)
# VITE_USE_FIREBASE_EMULATOR=false
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
